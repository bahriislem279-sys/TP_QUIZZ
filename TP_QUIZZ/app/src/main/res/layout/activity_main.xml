<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@color/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CULTURE QUIZ"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#EEF2FF"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Score : 0/5"
                android:textColor="@color/purple"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Progress Section -->
        <TextView
            android:id="@+id/txt_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Progression : 0/5"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/progress_quiz"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="6dp"
            android:max="5"
            android:progress="0"
            android:progressTint="@color/purple"
            android:progressBackgroundTint="#E2E8F0" />

        <!-- Main Question Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_background"
            android:layout_marginTop="16dp"
            android:padding="20dp">

            <TextView
                android:id="@+id/txt_question_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question 1 sur 5"
                android:textColor="@color/purple"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true" />

            <ImageView
                android:id="@+id/img_question"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                android:adjustViewBounds="true"
                android:background="#F8FAFC"
                android:contentDescription="Illustration de la question"
                android:padding="12dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/txt_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Question text"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Choices Section -->
        <Button
            android:id="@+id/btn_choix1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minHeight="50dp"
            android:text="Choix 1"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:backgroundTint="@color/card_background"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/btn_choix2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="50dp"
            android:text="Choix 2"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:backgroundTint="@color/card_background"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/btn_choix3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="50dp"
            android:text="Choix 3"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:backgroundTint="@color/card_background"
            android:textColor="@color/ink" />

        <!-- Feedback -->
        <TextView
            android:id="@+id/txt_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text=""
            android:textSize="15sp"
            android:textStyle="bold"
            android:accessibilityLiveRegion="polite" />

        <!-- Next Button -->
        <Button
            android:id="@+id/btn_suivant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="52dp"
            android:backgroundTint="@color/purple"
            android:enabled="false"
            android:text="Question suivante"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <!-- Result Layout Card -->
        <LinearLayout
            android:id="@+id/layout_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@color/card_background"
            android:padding="24dp"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Résultat final : 0/5"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_rejouer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="52dp"
                android:backgroundTint="@color/purple"
                android:text="Rejouer"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
